# Python
__pycache__/
*.py[cod]
*$py.class

# Environments
.env
.venv
env/
venv/
node_modules/

# Models & Pickles (blocks large files like clf_palm.pkl 538MB and clf_finger_signer.pkl 110MB)
*.pkl
!Integration-20260706T062240Z-3-001/Integration/enc_*.pkl
!Integration-20260706T062240Z-3-001/Integration/clf_view.pkl

# Large Archives & Datasets
*.zip
*.tar
*.tar.gz
*.npz

# Video files & Video directories
*.mp4
*.avi
*.mov
*.mkv
ISL_videos/
**/ISL_videos/
**/WLASL_videos/
**/European_sign_videos/
**/videos/

# Webapp specific temporary files
webapp/uploads/
webapp/static/output/
webapp/static/temp/

# HTML files (ignore root report HTMLs, keep webapp templates)
*.html
!webapp/templates/*.html

# All PDF files EXCEPT Comprehensive_V1_vs_Current_Pipeline_Comparison_V2.pdf
*.pdf
!Comprehensive_V1_vs_Current_Pipeline_Comparison_V2.pdf

# All Markdown files EXCEPT HYBRID_NN_ARCHITECTURE_AND_TRAINING_SPECIFICATION.md
*.md
!HYBRID_NN_ARCHITECTURE_AND_TRAINING_SPECIFICATION.md

# LaTeX temporary files
*.aux
*.log
*.nav
*.out
*.snm
*.toc
*.vrb

# Images
*.png
*.jpg
*.jpeg

# IDEs & OS artifacts
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db
.gradio/
**/.gradio/
.agents/
